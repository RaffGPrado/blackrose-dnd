{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "backend": {
      "entry": ["src/index.ts", "src/scripts/seed.ts", "src/scripts/reset_password.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "frontend": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
