# 🌹 Black Rose D&D 5e — Environment Variables
PORT=4000
NODE_ENV=production

# JWT Authentication Secret (Use a long random string in production)
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Domain for automatic HTTPS with Caddy (e.g. rpg.yourdomain.com or localhost)
DOMAIN=localhost

# Allowed CORS Origin (e.g. https://rpg.yourdomain.com or *)
CORS_ORIGIN=*

# Optional: Path to custom spell card images directory (read-only)
# By default, cards are looked up in ./assets/magic_cards or provided via volume
CARDS_PATH=./assets/magic_cards
